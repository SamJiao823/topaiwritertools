# ===== topaiwritertools.com .gitignore =====
# 目的：防止下次 git push 时把内部文件/密钥公开上线（项目为 Cloudflare Pages git 自动部署）
# 规则：公开上线只需要 *.html, og-image.png, robots.txt, sitemap.xml, _headers, README.md, assets/AI-Writing-Prompts-Pack.pdf

# --- 系统文件 ---
.DS_Store
Thumbs.db

# --- 密钥/凭据（绝对不要提交） ---
tools/
*.config.json

# --- 内部文档与计划（备份到飞书/本地，不上线） ---
docs/
_backup_phase0/
_backup_writesonic_swap/
.claude/

# --- Python 构建缓存 ---
__pycache__/

# --- 内部自动化脚本（含渠道规则/人类化方法论，公开会被复制） ---
scripts/
# 文章构建脚本/模板（head 模板含埋点配置，不随站上线）
_*.py
_head-template.html
_alternative-template.html

# --- 本地浏览器自动化状态（Playwright 临时 profile，别上线） ---
.fb-scan-profile/
.x-main-profile/
.x-tools-chrome/

# --- 本地设计草稿（X 头像/YouTube banner/Shorts 卡，别上线） ---
assets/x-profile/
assets/youtube-banner-source.html
assets/youtube-shorts1-cards/

# --- 内部内容草稿 ---
zh-content/

# --- 诱饵源文件（PDF 才是对外交付物，源文件公开会让人白拿） ---
assets/prompt-pack-100.md
assets/ai-writing-prompts-pack.html
assets/ecommerce-copy-pack.md
assets/ecommerce-copy-pack.html
# 付费产品 PDF（只在 Payhip 出售，绝不能公开）
assets/E-Commerce-Copy-Pack.pdf
.gstack/
